<!--
  ~ material's mtrl_text_btn_text_color_selector with the enabled color moved from
  ~ ?attr/colorPrimary to ?attr/colorOnSurface. The disabled alpha stays at material's 0.38
  ~ because MaterialDatePicker calls setEnabled on the confirm button whenever the selection
  ~ changes, so the two states still have to read apart. Only MoneyWalletDatePickerDark points
  ~ at this file.
  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.38" android:color="?attr/colorOnSurface" android:state_enabled="false"/>
    <item android:alpha="1.00" android:color="?attr/colorOnSurface"/>
</selector>
